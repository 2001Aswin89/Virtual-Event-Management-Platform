                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const response = pm.response.json();\r",
                                    "\r",
                                    "if (pm.response.code === 200 && response.token) {\r",
                                    "  pm.collectionVariables.set('token', response.token);\r",
                                    "\r",
                                    "  console.log('Token saved successfully');\r",
                                    "} else {\r",
                                    "  pm.collectionVariables.unset('token');\r",
                                    "\r",
                                    "  console.log('Token removed');\r",
                                    "}"
                                ],
                                "type": "text/javascript",
                                "packages": {},
                                "requests": {}
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\r\n  \"email\": \"aswin@test.com\",\r\n  \"password\": \"123456\"\r\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}api/auth/login",
                            "host": [
